# ---- Supabase (project settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...          # only used by admin magic-link auth
SUPABASE_SERVICE_ROLE_KEY=eyJ...              # server only. never expose to the browser.

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...               # from `npm run stripe:listen` locally

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SESSION_SECRET=                               # openssl rand -hex 32
ADMIN_EMAILS=host@example.com,cohost@example.com

# ---- Alerts ----
# Where "someone paid for a seat that doesn't exist" goes. Without these the
# alert still reaches the server log and the /admin banner, but nobody's phone.
RESEND_API_KEY=re_...
ALERT_EMAIL_FROM=Sabha <alerts@sabha.example>

# ---- Optional ----
SEAT_HOLD_MINUTES=15
